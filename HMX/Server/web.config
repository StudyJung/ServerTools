<?xml version="1.0" encoding="utf-8"?>
<!-- IIS 실행 (HttpPlatformHandler + .exe) -->
<!-- 필요: HttpPlatformHandler v1.2 만 (.NET·ASP.NET Core 런타임: Server.exe 에 포함, 설치 불필요) / 사이트 물리 경로 = exe 폴더 (빌드 시 이 파일 복사, 경로는 사이트 루트 기준), 앱 풀 = 관리 코드 없음 -->
<!-- 재빌드: 앱 풀 중지 후 빌드 (실행 중 .exe 잠김) -->
<!-- HTTPS: IIS 바인딩 https 만 (http 바인딩 없음, 인증서) + Server.json bHttps true (로그인 쿠키 Secure·HSTS 헤더·알람 링크 https) -->
<configuration>
	<system.webServer>
		<handlers>
			<add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />	<!-- 모든 요청을 전달 -->
		</handlers>
		<httpPlatform processPath=".\Server.exe"
		              arguments="%HTTP_PLATFORM_PORT%"
		              startupTimeLimit="30"
		              stdoutLogEnabled="false"
		              stdoutLogFile=".\log\iis">	<!-- 포트: IIS 가 지정 → .cs args[0], 콘솔 출력 → log\iis_*.log -->
		</httpPlatform>
	</system.webServer>
</configuration>
