<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Features>$(Features);FileBasedProgram</Features>						<!-- Server.cs 의 #!, #: 지시문 허용 (단일 파일 실행과 소스 공유) -->
		<RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>	<!-- 실행 폴더 = Server 폴더 (wwwroot 인식) -->
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>					<!-- staticwebassets.runtime.json·endpoints.json 미생성 (UseStaticFiles 사용, MapStaticAssets 미사용) -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>							<!-- 윈도우 x64 고정: runtimes 폴더 미생성 (윈도우용 dll 바로 사용), 단일 exe 게시 조건 -->
		<SelfContained>false</SelfContained>									<!-- 프레임워크 종속 고정 (RuntimeIdentifier 지정 시 게시가 self-contained 로 바뀌어 런타임 전체가 exe 폴더에 복사되는 것 방지) -->
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>	<!-- 출력 경로에 win-x64 하위 폴더 안 만듦 -->
		<GenerateDependencyFile>false</GenerateDependencyFile>					<!-- Server.deps.json 미생성 (exe 폴더의 dll 직접 탐색) -->
		<OutputPath>obj\$(Configuration)\out\</OutputPath>						<!-- 빌드 중간 출력: dll·runtimeconfig.json 등 단일 exe 재료 (F5 디버깅 실행 위치) -->
		<PublishDir>bin\$(Configuration)\$(TargetFramework)\</PublishDir>		<!-- exe 폴더 = 게시 출력: Server.exe 단일 파일만 새로 생성 (그 외 파일은 직접 관리: 빌드·리빌드·clean·게시 시 복사·삭제 안 함) -->
		<PublishSingleFile>true</PublishSingleFile>								<!-- 게시: dll·runtimeconfig.json 을 Server.exe 하나로 합침 -->
		<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>	<!-- 게시: pdb 미복사 (빌드 중간 출력은 디버깅용 pdb 유지) -->
		<IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>		<!-- 게시: web.config 자동 변환(aspNetCore 핸들러 추가) 안 함 (HttpPlatformHandler 유지) -->
		<ServerGarbageCollection>true</ServerGarbageCollection>				<!-- 서버 GC: 적재 워커 (코어 수 × 2.5) 가 동시에 할당 → 워크스테이션 GC 는 수집마다 모든 워커 중단 (부하 테스트: CPU 20% 에 워커당 1,300줄/s), .NET 9+ DATAS 기본 → 힙 수 동적 (장시간 실행 메모리 절약 유지), Server.cs 의 #:property 와 같음 -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />	<!-- 윈도우 서비스 실행 (Server.cs 의 #:package 와 같은 버전) -->
		<PackageReference Include="StackExchange.Redis" Version="2.13.17" />	<!-- Redis (관리 탭 패치 시각·동접 기록, Server.cs 의 #:package 와 같은 버전) -->
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Common\*.cs" Link="Common\%(Filename)%(Extension)" />	<!-- 공통 소스 (Client 와 같이 씀, Server.cs 의 #:include ../../Common 과 같음) -->
	</ItemGroup>

	<ItemGroup>
		<None Update="Server.html" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />	<!-- 기본 페이지: 빌드·게시 출력에 복사 안 함 (exe 폴더에서 직접 관리) -->
		<Content Update="Json\*.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />				<!-- 설정 파일 Json 폴더 (Server·Query·Alarm·Field·Manager·Account.json): 빌드·게시 출력에 복사 안 함 (Server\Json 폴더에서만 관리) -->
		<Content Update="web.config" CopyToPublishDirectory="Never" />									<!-- IIS 설정: exe 폴더(게시 출력)에 복사 안 함 (exe 폴더에서 직접 관리, HttpPlatformHandler) -->
		<Content Update="wwwroot\**" CopyToPublishDirectory="Never" />									<!-- 정적 파일: exe 폴더(게시 출력)에 복사 안 함 (exe 폴더에서 직접 관리) -->
		<None Update="*.md;*.txt" CopyToPublishDirectory="Never" />									<!-- md·txt 파일: exe 폴더(게시 출력)에 복사 안 함 (exe 폴더에서 직접 관리) -->
	</ItemGroup>

	<Target Name="PublishExe" AfterTargets="Build" Condition="'$(_IsPublishing)' != 'true' And '$(NoBuild)' != 'true'">	<!-- 빌드 후 exe 폴더(bin\설정\net10.0)에 단일 Server.exe 게시 (dotnet publish 시에는 생략) -->
		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="NoBuild=true;Configuration=$(Configuration)" />
	</Target>

	<Target Name="KeepFiles" BeforeTargets="_IncrementalCleanPublishDirectory">	<!-- exe 폴더(bin\설정\net10.0)의 기존 파일 전부 보호: 게시 정리(이전 게시 파일 삭제) 대상에서 제외 → 빌드·리빌드·clean·게시 시 삭제 안 함 -->
		<ItemGroup>
			<_PriorPublishFileWrites Remove="@(_PriorPublishFileWrites)" />
		</ItemGroup>
	</Target>

</Project>
