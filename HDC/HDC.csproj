<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>obj\$(Configuration)\out\</OutputPath>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\</PublishDir>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <Target Name="PublishExe" AfterTargets="Build" Condition="'$(_IsPublishing)' != 'true' And '$(NoBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="NoBuild=true;Configuration=$(Configuration)" />
  </Target>

  <Target Name="KeepFiles" BeforeTargets="_IncrementalCleanPublishDirectory">
    <ItemGroup>
      <_PriorPublishFileWrites Remove="@(_PriorPublishFileWrites)" />
    </ItemGroup>
  </Target>
</Project>
