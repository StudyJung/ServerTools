{
  "Base": {
    "bLog": true,
    "sZone": "Real"
  },

  "sIP": "127.0.0.1",
  "nPort": 801,

  "nLogRead": 1000,
  "nLogSend": 100,

  "aLogFolder": [
    "C:\\NHNServices",
    "D:\\SRC\\ServerTools\\LogManager\\LMClient\\bin\\Release\\net10.0\\Log"
  ],

  "aLogType": [
    "WARN",
    "NOTI",
    "ERROR",
    "FATAL"
  ],

  "aField": [
    {
      "sKey": "ip",
      "sRegex": "(?<![\\d.])(\\d{1,3}(?:\\.\\d{1,3}){3}(?::\\d{1,5})?)(?![\\d.])"
    },
    {
      "sKey": "sno",
      "sRegex": "(?i:sno|userid)[^\\p{L}\\p{N}]*(\\d+)"
    },
    {
      "sKey": "tno",
      "sRegex": "(?i:tno|hno)[^\\p{L}\\p{N}]*(\\d+)"
    },
    {
      "sKey": "hid",
      "sRegex": "(?i:hid)[^\\p{L}\\p{N}]*(\\d+)"
    },
    {
      "sKey": "nick",
      "sRegex": "(?i:nick|nick_name|nickname)[^\\p{L}\\p{N}]*(\\d+)"
    }
  ]
}
