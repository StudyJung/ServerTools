<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Features>$(Features);FileBasedProgram</Features>						<!-- LMServer.cs 의 #!, #: 지시문 허용 (단일 파일 실행과 소스 공유) -->
		<RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>	<!-- 실행 폴더 = LMServer 폴더 (wwwroot 인식) -->
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>					<!-- staticwebassets.runtime.json·endpoints.json 미생성 (UseStaticFiles 사용, MapStaticAssets 미사용) -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>							<!-- 윈도우 x64 고정: runtimes 폴더 미생성 (윈도우용 dll 바로 사용), 단일 exe 게시 조건 -->
		<SelfContained>false</SelfContained>									<!-- 프레임워크 종속 고정 (RuntimeIdentifier 지정 시 게시가 self-contained 로 바뀌어 런타임 전체가 exe 폴더에 복사되는 것 방지) -->
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>	<!-- 출력 경로에 win-x64 하위 폴더 안 만듦 -->
		<GenerateDependencyFile>false</GenerateDependencyFile>					<!-- LMServer.deps.json 미생성 (exe 폴더의 dll 직접 탐색) -->
		<OutputPath>obj\$(Configuration)\out\</OutputPath>						<!-- 빌드 중간 출력: dll·runtimeconfig.json 등 단일 exe 재료 (F5 디버깅 실행 위치) -->
		<PublishDir>bin\$(Configuration)\$(TargetFramework)\</PublishDir>		<!-- exe 폴더 = 게시 출력: LMServer.exe 단일 파일 + web.config + wwwroot (LMServer.json 은 직접 복사, 빌드·리빌드·clean 시 삭제 안 함) -->
		<PublishSingleFile>true</PublishSingleFile>								<!-- 게시: dll·runtimeconfig.json 을 LMServer.exe 하나로 합침 -->
		<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>	<!-- 게시: pdb 미복사 (빌드 중간 출력은 디버깅용 pdb 유지) -->
		<IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>		<!-- 게시: web.config 자동 변환(aspNetCore 핸들러 추가) 안 함 (HttpPlatformHandler 유지) -->
		<ServerGarbageCollection>false</ServerGarbageCollection>				<!-- 워크스테이션 GC: Web SDK 기본 서버 GC 대신 (코어 수만큼 힙을 잡지 않음 → 장시간 실행 메모리 절약, LMServer.cs 의 #:property 와 같음) -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />	<!-- 윈도우 서비스 실행 (LMServer.cs 의 #:package 와 같은 버전) -->
	</ItemGroup>

	<ItemGroup>
		<None Update="LMServer.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />	<!-- 기본 페이지: 빌드·게시 출력에 복사 (IIS 실행 시 필요) -->
		<Content Update="LMServer.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />				<!-- 설정 파일: 빌드·게시 출력에 복사 안 함 (LMServer 폴더에서만 관리) -->
		<Content Update="web.config" CopyToPublishDirectory="PreserveNewest" />									<!-- IIS 설정: exe 폴더(게시 출력)에 복사 (Release·Debug 공통, HttpPlatformHandler) -->
		<Content Update="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />									<!-- 정적 파일: exe 폴더(게시 출력)에 복사 (exe·서비스·IIS 실행 시 wwwroot 인식) -->
		<None Update="*.md;*.txt" CopyToPublishDirectory="PreserveNewest" />									<!-- md·txt 파일 (.cs 와 같은 폴더, 하위 폴더 제외): exe 폴더(게시 출력)에 복사 -->
	</ItemGroup>

	<Target Name="PublishExe" AfterTargets="Build" Condition="'$(_IsPublishing)' != 'true' And '$(NoBuild)' != 'true'">	<!-- 빌드 후 exe 폴더(bin\설정\net10.0)에 단일 LMServer.exe 게시 (dotnet publish 시에는 생략) -->
		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="NoBuild=true;Configuration=$(Configuration)" />
	</Target>

	<Target Name="KeepJsonFiles" BeforeTargets="_IncrementalCleanPublishDirectory">	<!-- exe 폴더(bin\설정\net10.0)의 모든 *.json 보호: 게시 정리(이전 게시 파일 삭제) 대상에서 제외 → 빌드·리빌드·clean·게시 시 삭제 안 함 -->
		<ItemGroup>
			<_PriorPublishFileWrites Remove="@(_PriorPublishFileWrites)" Condition="'%(Extension)' == '.json'" />
		</ItemGroup>
	</Target>

</Project>
